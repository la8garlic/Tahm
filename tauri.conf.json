{
  "productName": "Tahm",
  "version": "1.0.1",
  "identifier": "local.aclean.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "塔姆 · 磁盘空间分析",
        "decorations": false,
        "devtools": false,
        "width": 1240,
        "height": 820,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:",
      "capabilities": [
        {
          "identifier": "main-window-controls",
          "windows": ["main"],
          "permissions": [
            "core:window:allow-set-title",
            "core:window:allow-start-dragging",
            "core:window:allow-internal-toggle-maximize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-is-maximized",
            "core:window:allow-minimize",
            "core:window:allow-close"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Tahm",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
